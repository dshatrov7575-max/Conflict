# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# PostgreSQL is the default backend. The db hostname is for Docker Compose.
POSTGRES_DB=conflict_analysis
POSTGRES_USER=conflict_analysis
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Explicit opt-in for fast local tests only. PostgreSQL remains the integration gate.
USE_SQLITE=false
SQLITE_PATH=/app/db.sqlite3
