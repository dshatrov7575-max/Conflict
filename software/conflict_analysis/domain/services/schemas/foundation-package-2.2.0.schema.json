{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflictology.invalid/schemas/foundation-package-2.2.0.schema.json",
  "title": "Conflict Analysis Foundation Package 2.2.0",
  "description": "Exact reconciliation envelope for one existing COMPLETE Foundation workspace assessment projection; it is not a workspace or database restore format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "package_scope",
    "package_id",
    "project",
    "selected_definition_id",
    "workspace",
    "manifest",
    "projection",
    "actors",
    "analytical_elements",
    "actor_element_roles",
    "parameter_definitions"
  ],
  "properties": {
    "format": {
      "const": "conflict-analysis-foundation"
    },
    "format_version": {
      "const": "2.2.0"
    },
    "package_scope": {
      "const": "WORKSPACE_ASSESSMENT_PROJECTION"
    },
    "package_id": {
      "$ref": "#/$defs/code"
    },
    "project": {
      "$ref": "#/$defs/project_identity"
    },
    "selected_definition_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace": {
      "$ref": "#/$defs/workspace_identity"
    },
    "manifest": {
      "$ref": "#/$defs/definition_manifest"
    },
    "projection": {
      "$ref": "#/$defs/projection"
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "analytical_elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analytical_element"
      }
    },
    "actor_element_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor_element_role"
      }
    },
    "parameter_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter_definition"
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "uuid_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "decimal_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/decimal_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "workspace_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "version",
        "project_definition_version_id",
        "project_definition_hash",
        "label",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "project_definition_version_id": {
          "$ref": "#/$defs/uuid"
        },
        "project_definition_hash": {
          "$ref": "#/$defs/sha256"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "definition_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "sha256",
        "payload"
      ],
      "properties": {
        "definition_id": {
          "$ref": "#/$defs/uuid"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload": {
          "$ref": "project-definition-manifest-1.0.0.schema.json"
        }
      }
    },
    "projection_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "sha256",
        "payload"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "status",
        "receipt",
        "projection_sha256",
        "source_mapping_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "contract": {
          "const": "FOUNDATION_WORKSPACE_ASSESSMENT_PROJECTION_V1"
        },
        "status": {
          "const": "COMPLETE"
        },
        "receipt": {
          "$ref": "#/$defs/projection_receipt"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_mapping_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "version",
        "source_manifest_entity_id",
        "source_manifest_entity_sha256",
        "source_manifest_parent_id",
        "actor_type",
        "label",
        "description",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "source_manifest_entity_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_manifest_entity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_parent_id": {
          "$ref": "#/$defs/uuid_or_null"
        },
        "actor_type": {
          "enum": [
            "INDIVIDUAL",
            "GROUP",
            "ORGANIZATION",
            "INSTITUTION",
            "STATE",
            "OTHER"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "analytical_element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "version",
        "source_manifest_entity_id",
        "source_manifest_entity_sha256",
        "source_manifest_parent_id",
        "element_type",
        "label",
        "description",
        "reference_statement",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "source_manifest_entity_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_manifest_entity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_parent_id": {
          "$ref": "#/$defs/uuid_or_null"
        },
        "element_type": {
          "enum": [
            "CONFLICT_ISSUE",
            "GRIEVANCE",
            "STRUCTURAL_DRIVER",
            "PROXIMATE_DRIVER",
            "TRIGGER",
            "PROCESS",
            "INSTITUTIONAL_RESPONSE",
            "CONSEQUENCE",
            "PEACE_FACTOR"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "reference_statement": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "actor_element_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "version",
        "source_manifest_entity_id",
        "source_manifest_entity_sha256",
        "source_manifest_actor_id",
        "source_manifest_element_id",
        "source_manifest_order",
        "role",
        "note",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "source_manifest_entity_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_manifest_entity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_actor_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_manifest_element_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_manifest_order": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "PRIMARY",
            "SECONDARY",
            "AFFECTED",
            "INTERMEDIARY",
            "OBSERVER",
            "OTHER"
          ]
        },
        "note": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "parameter_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "version",
        "definition_version_id",
        "source_manifest_parameter_id",
        "manifest_snapshot_sha256",
        "name",
        "description",
        "target_type",
        "value_type",
        "scale_min",
        "scale_max",
        "scale_step",
        "scale_metadata",
        "allowed_statuses",
        "applicability",
        "reference_statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "definition_version_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_manifest_parameter_id": {
          "$ref": "#/$defs/uuid"
        },
        "manifest_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string"
        },
        "target_type": {
          "enum": [
            "PROJECT",
            "TIME_SLICE",
            "ACTOR",
            "ANALYTICAL_ELEMENT",
            "ACTOR_ELEMENT_ROLE",
            "ACTOR_ELEMENT_ASSESSMENT"
          ]
        },
        "value_type": {
          "enum": [
            "DECIMAL",
            "INTEGER",
            "BOOLEAN",
            "TEXT",
            "JSON"
          ]
        },
        "scale_min": {
          "$ref": "#/$defs/decimal_or_null"
        },
        "scale_max": {
          "$ref": "#/$defs/decimal_or_null"
        },
        "scale_step": {
          "$ref": "#/$defs/decimal_or_null"
        },
        "scale_metadata": {
          "type": "object"
        },
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "UNKNOWN",
              "NOT_APPLICABLE",
              "INSUFFICIENT_DATA",
              "PROVISIONAL",
              "CONFIRMED",
              "OPEN_METHOD",
              "DISPUTED",
              "RETROSPECTIVE_KNOWLEDGE"
            ]
          }
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "reference_statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_ids",
        "analytical_element_ids",
        "actor_element_role_ids"
      ],
      "properties": {
        "actor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "analytical_element_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "actor_element_role_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    }
  }
}
