{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conflict Analysis MVP7 Case Mapping 1.0.0",
  "description": "Standalone descriptive mapping. No historical dataset mutation, numeric assessment or calculation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_kind", "dataset_reference", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_kind": {"enum": ["STRUCTURE_ONLY", "CASE_MAPPING"]},
    "dataset_reference": {"anyOf": [{"$ref": "#/$defs/source_reference"}, {"type": "null"}]},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "allOf": [
    {
      "if": {"properties": {"document_kind": {"const": "STRUCTURE_ONLY"}}},
      "then": {
        "properties": {
          "dataset_reference": {"type": "null"},
          "cases": {"items": {
            "properties": {
              "country": {"type": "null"},
              "time_period": {"properties": {"start_date": {"type": "null"}, "end_date": {"type": "null"}}},
              "episode_boundary": {"type": "null"},
              "source_reference": {"maxItems": 0},
              "episodes": {"items": {
                "properties": {
                  "start_date": {"type": "null"},
                  "end_date": {"type": "null"},
                  "description": {"type": "null"},
                  "outcome_class": {"type": "null"},
                  "evidence": {"maxItems": 0},
                  "factor_mappings": {"items": {
                    "properties": {
                      "evidence_reference": {"maxItems": 0},
                      "observed_indicator": {"type": "null"},
                      "confidence_level": {"const": "UNKNOWN"},
                      "mapping_status": {"const": "UNKNOWN"},
                      "mapping_rationale": {"type": "null"}
                    }
                  }},
                  "outcome": {"properties": {
                    "event_type": {"type": "null"},
                    "escalation_level": {"type": "null"},
                    "resolution_type": {"type": "null"}
                  }}
                }
              }}
            }
          }}
        }
      }
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nullable_text": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "date": {"anyOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, {"type": "null"}]},
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "version", "locator"],
      "properties": {
        "reference": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/nullable_text"},
        "locator": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "time_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {"start_date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/date"}}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "country", "time_period", "episode_boundary", "source_reference", "episodes"],
      "properties": {
        "case_id": {"$ref": "#/$defs/text"},
        "country": {"$ref": "#/$defs/nullable_text"},
        "time_period": {"$ref": "#/$defs/time_period"},
        "episode_boundary": {"$ref": "#/$defs/nullable_text"},
        "source_reference": {"type": "array", "items": {"$ref": "#/$defs/source_reference"}},
        "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "start_date", "end_date", "description", "outcome_class", "evidence", "factor_mappings", "outcome"],
      "properties": {
        "episode_id": {"$ref": "#/$defs/text"},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "description": {"$ref": "#/$defs/nullable_text"},
        "outcome_class": {"$ref": "#/$defs/nullable_text"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "factor_mappings": {"type": "array", "items": {"$ref": "#/$defs/factor_mapping"}},
        "outcome": {"$ref": "#/$defs/outcome"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_reference", "observed_evidence"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/text"},
        "source_reference": {"$ref": "#/$defs/source_reference"},
        "observed_evidence": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "factor_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "factor_id", "evidence_reference", "observed_indicator", "confidence_level", "mapping_status", "mapping_rationale"],
      "properties": {
        "mapping_id": {"$ref": "#/$defs/text"},
        "factor_id": {"enum": ["POS", "KVS", "RGU", "KVPTN", null]},
        "evidence_reference": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "observed_indicator": {"$ref": "#/$defs/nullable_text"},
        "confidence_level": {"enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH"]},
        "mapping_status": {"enum": ["CONFIRMED", "PARTIAL", "DISPUTED", "UNKNOWN"]},
        "mapping_rationale": {"$ref": "#/$defs/nullable_text"}
      },
      "allOf": [
        {
          "if": {"properties": {"mapping_status": {"enum": ["CONFIRMED", "PARTIAL", "DISPUTED"]}}},
          "then": {"properties": {
            "factor_id": {"enum": ["POS", "KVS", "RGU", "KVPTN"]},
            "evidence_reference": {"minItems": 1},
            "observed_indicator": {"$ref": "#/$defs/text"},
            "mapping_rationale": {"$ref": "#/$defs/text"}
          }}
        },
        {
          "if": {"properties": {"confidence_level": {"enum": ["LOW", "MEDIUM", "HIGH"]}}},
          "then": {"properties": {
            "evidence_reference": {"minItems": 1},
            "mapping_rationale": {"$ref": "#/$defs/text"}
          }}
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "escalation_level", "resolution_type"],
      "properties": {
        "event_type": {"$ref": "#/$defs/nullable_text"},
        "escalation_level": {"$ref": "#/$defs/nullable_text"},
        "resolution_type": {"$ref": "#/$defs/nullable_text"}
      }
    }
  }
}
