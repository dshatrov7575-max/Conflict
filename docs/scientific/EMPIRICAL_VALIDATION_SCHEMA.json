{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conflict Analysis MVP7 ValidationPilot 1.0.0",
  "description": "Preparation metadata only. STRUCTURE_ONLY is an unfilled template; PREPARATION requires a cutoff but does not assert empirical validation or authorize calculation. Date ordering and artifact resolution require separate checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilot_id", "case_id", "country", "event_period", "information_cutoff_date", "evidence_package_reference", "case_mapping_reference", "factor_mapping_reference", "historical_assessment_reference", "observed_outcome_reference", "limitations", "status"],
  "properties": {
    "pilot_id": {"$ref": "#/$defs/text"},
    "case_id": {"$ref": "#/$defs/text"},
    "country": {"$ref": "#/$defs/nullable_text"},
    "event_period": {"$ref": "#/$defs/period"},
    "information_cutoff_date": {"$ref": "#/$defs/nullable_date"},
    "evidence_package_reference": {"$ref": "#/$defs/artifact"},
    "case_mapping_reference": {"$ref": "#/$defs/artifact"},
    "factor_mapping_reference": {"$ref": "#/$defs/artifact"},
    "historical_assessment_reference": {"$ref": "#/$defs/nullable_artifact"},
    "observed_outcome_reference": {"$ref": "#/$defs/nullable_artifact"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "status": {"enum": ["STRUCTURE_ONLY", "PREPARATION"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "STRUCTURE_ONLY"}}},
      "then": {"properties": {
        "country": {"type": "null"},
        "event_period": {"properties": {"start_date": {"type": "null"}, "end_date": {"type": "null"}}},
        "information_cutoff_date": {"type": "null"},
        "historical_assessment_reference": {"type": "null"},
        "observed_outcome_reference": {"type": "null"}
      }},
      "else": {"properties": {
        "country": {"$ref": "#/$defs/text"},
        "event_period": {"properties": {"start_date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/date"}}},
        "information_cutoff_date": {"$ref": "#/$defs/date"},
        "evidence_package_reference": {"$ref": "#/$defs/pinned_data"},
        "case_mapping_reference": {"$ref": "#/$defs/pinned_data"},
        "factor_mapping_reference": {"$ref": "#/$defs/pinned_data"},
        "historical_assessment_reference": {"anyOf": [{"$ref": "#/$defs/pinned_data"}, {"type": "null"}]},
        "observed_outcome_reference": {"anyOf": [{"$ref": "#/$defs/pinned_data"}, {"type": "null"}]}
      }}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nullable_text": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"},
    "nullable_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {"start_date": {"$ref": "#/$defs/nullable_date"}, "end_date": {"$ref": "#/$defs/nullable_date"}}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "artifact_kind", "json_pointer"],
      "properties": {
        "reference": {"$ref": "#/$defs/text"},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "artifact_kind": {"enum": ["DATA", "STRUCTURE_ONLY"]},
        "json_pointer": {"anyOf": [{"type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$"}, {"type": "null"}]}
      }
    },
    "nullable_artifact": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "pinned_data": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"artifact_kind": {"const": "DATA"}, "sha256": {"$ref": "#/$defs/sha256"}}}
      ]
    }
  }
}
